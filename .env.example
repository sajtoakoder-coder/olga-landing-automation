# ===== Telegram Bot =====
# Токен бота — получить у @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# chat_id Ольги. Отправь боту /start — он пришлёт chat_id в ответ. Вставь сюда.
TELEGRAM_ADMIN_CHAT_ID=

# ===== ЮMoney (на старте — заглушки, реальные ключи позже) =====
# Номер кошелька ЮMoney (receiver) для quickpay-формы
YOOMONEY_SHOP_ID=test_shop
# Секрет для проверки подписи HTTP-уведомлений ЮMoney
YOOMONEY_SECRET_KEY=test_secret
# Куда вернуть клиента после успешной оплаты
YOOMONEY_REDIRECT_URL=https://your-domain.vercel.app/site/success.html
# URL вебхука для уведомлений ЮMoney
YOOMONEY_WEBHOOK_URL=https://your-domain.vercel.app/api/payment/webhook

# ===== Email (заглушка на старте; реальный SMTP подключается только через env) =====
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
# stub — письма только логируются + уведомление в бот; live — реальная отправка по SMTP
EMAIL_MODE=stub

# ===== Телемост =====
# Дефолтная ссылка на Телемост (можно задать и через бота: Настройки → Ссылка на Телемост)
DEFAULT_TELEMOST_URL=

# ===== App =====
# Публичный URL деплоя (без слэша в конце)
APP_URL=https://your-domain.vercel.app
# stub — тестовая страница оплаты вместо ЮMoney; live — реальный редирект на ЮMoney
PAYMENT_MODE=stub
# Часовой пояс для слотов и статистики
APP_TZ=Europe/Moscow

# ===== Хранилище =====
# file — JSON-файл (локально / на Vercel /tmp, данные не переживают cold start);
# upstash — Vercel KV / Upstash Redis; supabase — Postgres на Supabase.
# Автовыбор при пустом STORAGE_BACKEND: supabase (если заданы креды) → upstash → file.
STORAGE_BACKEND=
# Путь к JSON-файлу для file-бэкенда (по умолчанию ./data/store.json, на Vercel /tmp/olga_store.json)
STORAGE_PATH=
# Vercel KV / Upstash (проставляются интеграцией Vercel автоматически)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Supabase: Project Settings → API. Ключ — service_role (secret).
# Таблица создаётся один раз в SQL Editor:
#   create table if not exists olga_records (
#     kind text not null, id text not null, data jsonb not null,
#     primary key (kind, id));
#   alter table olga_records enable row level security;
SUPABASE_URL=
SUPABASE_KEY=
